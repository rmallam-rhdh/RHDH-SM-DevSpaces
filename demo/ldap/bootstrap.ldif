# Seeded after osixia creates dc=acme,dc=demo from LDAP_DOMAIN=acme.demo
# Group cn values must match Entra security group names.

dn: ou=people,dc=acme,dc=demo
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=acme,dc=demo
objectClass: organizationalUnit
ou: groups

# --- people (mail local-part is what you recreate in Entra) ---

dn: uid=alice,ou=people,dc=acme,dc=demo
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Alice Developer
sn: Developer
givenName: Alice
uid: alice
mail: mallamrakesh@gmail.com
uidNumber: 10001
gidNumber: 10000
homeDirectory: /home/alice
loginShell: /bin/bash
userPassword: AliceDev1!

dn: uid=bob,ou=people,dc=acme,dc=demo
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Bob Platform
sn: Platform
givenName: Bob
uid: bob
mail: bob@mallamrakeshgmail.onmicrosoft.com
uidNumber: 10002
gidNumber: 10000
homeDirectory: /home/bob
loginShell: /bin/bash
userPassword: BobPlat1!

dn: uid=carol,ou=people,dc=acme,dc=demo
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Carol Owner
sn: Owner
givenName: Carol
uid: carol
mail: carol@mallamrakeshgmail.onmicrosoft.com
uidNumber: 10003
gidNumber: 10000
homeDirectory: /home/carol
loginShell: /bin/bash
userPassword: CarolApp1!

# Unonboarded corporate employee (NOT in cn=rhdh-users -> must NOT sync into RHDH Catalog!)
dn: uid=dave,ou=people,dc=acme,dc=demo
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Dave Finance
sn: Finance
givenName: Dave
uid: dave
mail: dave@mallamrakeshgmail.onmicrosoft.com
uidNumber: 10004
gidNumber: 10000
homeDirectory: /home/dave
loginShell: /bin/bash
userPassword: DaveFin1!

# --- Standalone Flat Portal Login Group (Assigned ONCE on Entra App + LDAP userFilter) ---

dn: cn=rhdh-users,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: rhdh-users
description: Flat Developer Hub Portal Login Group (direct user members only; excluded from RHDH Group sync)
member: uid=alice,ou=people,dc=acme,dc=demo
member: uid=bob,ou=people,dc=acme,dc=demo
member: uid=carol,ou=people,dc=acme,dc=demo

# --- groups (create these exact names as Entra security groups) ---

dn: cn=developers,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: developers
description: Application developers (maps to Entra group developers)
member: uid=alice,ou=people,dc=acme,dc=demo

dn: cn=platform-team,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: platform-team
description: Platform engineers (maps to Entra group platform-team)
member: uid=bob,ou=people,dc=acme,dc=demo

dn: cn=app-owners,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: app-owners
description: Application owners (maps to Entra group app-owners)
member: uid=carol,ou=people,dc=acme,dc=demo
member: uid=alice,ou=people,dc=acme,dc=demo

# --- Multi-team nested RBAC groups (Option 1: Parent Umbrella + Child RO/RW) ---

dn: cn=team-payments-rw,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-payments-rw
description: Payments Team Read-Write Engineers (Alice)
member: uid=alice,ou=people,dc=acme,dc=demo

dn: cn=team-payments-ro,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-payments-ro
description: Payments Team Read-Only Viewers (Bob)
member: uid=bob,ou=people,dc=acme,dc=demo

dn: cn=team-payments,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-payments
description: Payments Team Umbrella Group (spec.owner for Payments catalog entities)
member: cn=team-payments-rw,ou=groups,dc=acme,dc=demo
member: cn=team-payments-ro,ou=groups,dc=acme,dc=demo

dn: cn=team-retail-rw,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-retail-rw
description: Retail Team Read-Write Engineers (Carol)
member: uid=carol,ou=people,dc=acme,dc=demo

dn: cn=team-retail-ro,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-retail-ro
description: Retail Team Read-Only Viewers
member: uid=carol,ou=people,dc=acme,dc=demo

dn: cn=team-retail,ou=groups,dc=acme,dc=demo
objectClass: groupOfNames
cn: team-retail
description: Retail Team Umbrella Group (spec.owner for Retail catalog entities)
member: cn=team-retail-rw,ou=groups,dc=acme,dc=demo
member: cn=team-retail-ro,ou=groups,dc=acme,dc=demo
