// ─────────────────────────────────────────────────────────────────────────────
// Acme Standard Spring Boot Release Pipeline
// Generated by: RHDH Golden Path — Spring Boot Release Pipeline Template
// App: ${{ values.appName }}
//
// Pipeline stages:
//   1. Checkout
//   2. Unit Test
//   3. SonarQube Quality Gate        (if enableSonar=true)
//   4. Snyk Security Scan            (if enableSnyk=true)
//   5. Build & Push to Artifactory   (image tagged with git commit SHA)
//   6. Cosign Sign                   (if enableCosign=true)
//   7. Update GitOps Repo (dev)      (image digest pinned → Kyverno gate passes)
//   8. Deploy to Dev via ArgoCD sync
//   9. Integration Tests
//  10. Promote to Prod               (requires Jira change ticket if requireJiraTicket=true)
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        metadata:
          labels:
            app.kubernetes.io/name: jenkins-agent
            acme.io/mesh-enroll: "true"
        spec:
          serviceAccountName: jenkins-agent
          containers:
            - name: jnlp
              image: registry.redhat.io/ocp-tools-4/jenkins-agent-base-rhel8:latest
              resources:
                requests: { cpu: "200m", memory: "512Mi" }
                limits:   { cpu: "1",    memory: "2Gi"   }
            - name: gradle
              image: registry.access.redhat.com/ubi9/openjdk-${{ values.javaVersion }}:latest
              command: [cat]
              tty: true
              resources:
                requests: { cpu: "500m", memory: "1Gi"  }
                limits:   { cpu: "2",    memory: "4Gi"  }
            - name: buildah
              image: registry.redhat.io/ubi9/buildah:latest
              command: [cat]
              tty: true
              securityContext:
                privileged: false
                runAsNonRoot: true
              resources:
                requests: { cpu: "200m", memory: "512Mi" }
                limits:   { cpu: "1",    memory: "2Gi"   }
            - name: cosign
              image: registry.redhat.io/rhtas/cosign-rhel9:latest
              command: [cat]
              tty: true
            - name: tools
              image: registry.redhat.io/openshift4/ose-cli:latest
              command: [cat]
              tty: true
      '''
    }
  }

  environment {
    APP_NAME           = "${{ values.appName }}"
    ARTIFACTORY_REPO   = "${{ values.artifactoryRepo }}"
    GITOPS_REPO        = "https://bitbucket.org/${{ values.bitbucketWorkspace }}/${{ values.appName }}-gitops.git"
    DEV_NAMESPACE      = "${{ values.devNamespace }}"
    PROD_NAMESPACE     = "${{ values.prodNamespace }}"
    JENKINS_FOLDER     = "${{ values.jenkinsFolder }}"
    IMAGE_BASE         = "\${ARTIFACTORY_BASE_URL}/${ARTIFACTORY_REPO}/${APP_NAME}"
    IMAGE_TAG          = "\${GIT_COMMIT[0..7]}"
    IMAGE_FULL         = "\${IMAGE_BASE}:\${IMAGE_TAG}"

    // Credentials injected from Jenkins credential store (seeded from Vault)
    ARTIFACTORY_CREDS   = credentials('artifactory-docker-creds')
    SONAR_TOKEN         = credentials('sonarqube-token')
    SNYK_TOKEN          = credentials('snyk-token')
    COSIGN_KEY          = credentials('cosign-private-key')
    GITOPS_SSH_KEY      = credentials('bitbucket-gitops-ssh-key')
    ARGOCD_TOKEN        = credentials('argocd-token')
    JIRA_TOKEN          = credentials('jira-token')
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 60, unit: 'MINUTES')
    disableConcurrentBuilds()
    timestamps()
  }

  stages {

    // ── 1. Checkout ──────────────────────────────────────────────────────────
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          env.IMAGE_TAG   = env.GIT_COMMIT_SHORT
          env.IMAGE_FULL  = "${env.IMAGE_BASE}:${env.IMAGE_TAG}"
        }
      }
    }

    // ── 2. Unit Tests ────────────────────────────────────────────────────────
    stage('Unit Tests') {
      steps {
        container('gradle') {
          sh './gradlew test --no-daemon'
        }
      }
      post {
        always {
          junit '**/build/test-results/test/*.xml'
        }
      }
    }

    // ── 3. SonarQube Quality Gate ─────────────────────────────────────────
    stage('SonarQube Analysis') {
      when { expression { return '${{ values.enableSonar }}' == 'true' } }
      steps {
        container('gradle') {
          withSonarQubeEnv('acme-sonarqube') {
            sh """
              ./gradlew sonar \
                -Dsonar.projectKey=${{ values.sonarProjectKey or values.appName }} \
                -Dsonar.token=\${SONAR_TOKEN} \
                --no-daemon
            """
          }
        }
      }
    }
    stage('Quality Gate') {
      when { expression { return '${{ values.enableSonar }}' == 'true' } }
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    // ── 4. Snyk Security Scan ────────────────────────────────────────────────
    stage('Snyk Security Scan') {
      when { expression { return '${{ values.enableSnyk }}' == 'true' } }
      steps {
        container('gradle') {
          snykSecurity(
            snykInstallation: 'snyk-latest',
            snykTokenId: 'snyk-token',
            failOnIssues: true,
            severity: 'high',
            targetFile: 'build.gradle.kts',
            additionalArguments: '--all-projects'
          )
        }
      }
    }

    // ── 5. Build Image & Push to Artifactory ─────────────────────────────────
    stage('Build & Push Image') {
      steps {
        container('buildah') {
          sh """
            buildah login -u \${ARTIFACTORY_CREDS_USR} -p \${ARTIFACTORY_CREDS_PSW} \${ARTIFACTORY_BASE_URL}
            buildah bud --layers -t \${IMAGE_FULL} .
            buildah push \${IMAGE_FULL}

            # Also tag as latest for non-prod reference
            buildah tag \${IMAGE_FULL} \${IMAGE_BASE}:latest
            buildah push \${IMAGE_BASE}:latest

            # Capture digest for Kyverno release gate
            IMAGE_DIGEST=\$(buildah inspect --format '{{.FromImageDigest}}' \${IMAGE_FULL})
            echo "IMAGE_DIGEST=\${IMAGE_DIGEST}" > image.env
          """
          script {
            def props = readProperties file: 'image.env'
            env.IMAGE_DIGEST = props.IMAGE_DIGEST
            env.IMAGE_WITH_DIGEST = "${env.IMAGE_BASE}@${env.IMAGE_DIGEST}"
          }
        }
      }
    }

    // ── 6. Cosign Sign ───────────────────────────────────────────────────────
    stage('Sign Image (Cosign)') {
      when { expression { return '${{ values.enableCosign }}' == 'true' } }
      steps {
        container('cosign') {
          sh """
            cosign sign --key \${COSIGN_KEY} \${IMAGE_WITH_DIGEST} \
              --rekor-url=https://rhtas.\${CLUSTER_BASE_DOMAIN} \
              -a "git-commit=\${GIT_COMMIT_SHORT}" \
              -a "repo=\${GIT_URL}" \
              -a "jenkins-build=\${BUILD_URL}"
          """
        }
      }
    }

    // ── 7. Update GitOps Repo (dev) ──────────────────────────────────────────
    stage('Update GitOps (dev)') {
      steps {
        container('tools') {
          sshagent(credentials: ['bitbucket-gitops-ssh-key']) {
            sh """
              git clone \${GITOPS_REPO} gitops-repo
              cd gitops-repo

              # Pin image digest in dev overlay (satisfies require-image-digest Kyverno policy)
              sed -i "s|image:.*${APP_NAME}:.*|image: \${IMAGE_WITH_DIGEST}|g" overlays/dev/kustomization.yaml

              # Inject Jira change ticket annotation if on main branch
              if [[ "\${GIT_BRANCH}" == "main" || "\${GIT_BRANCH}" == "origin/main" ]]; then
                JIRA_TICKET="\${JIRA_CHANGE_TICKET:-DEV-\${BUILD_NUMBER}}"
                yq e ".patches[0].patch = \"- op: add\\n  path: /spec/template/metadata/annotations/acme.io~1jira-change-ticket\\n  value: \${JIRA_TICKET}\"" \
                  -i overlays/dev/deployment-patch.yaml 2>/dev/null || true
              fi

              git config user.email "jenkins@acme.example.com"
              git config user.name "Jenkins Release Pipeline"
              git add .
              git commit -m "chore: pin image digest \${IMAGE_TAG} [\${GIT_COMMIT_SHORT}]" || true
              git push origin main
            """
          }
        }
      }
    }

    // ── 8. Sync ArgoCD (dev) ─────────────────────────────────────────────────
    stage('Deploy to Dev') {
      steps {
        container('tools') {
          sh """
            argocd app sync \${APP_NAME}-dev \
              --server openshift-gitops-server-openshift-gitops.apps.\${CLUSTER_BASE_DOMAIN} \
              --auth-token \${ARGOCD_TOKEN} \
              --grpc-web \
              --timeout 120

            argocd app wait \${APP_NAME}-dev \
              --server openshift-gitops-server-openshift-gitops.apps.\${CLUSTER_BASE_DOMAIN} \
              --auth-token \${ARGOCD_TOKEN} \
              --health --timeout 180
          """
        }
      }
    }

    // ── 9. Integration Tests ─────────────────────────────────────────────────
    stage('Integration Tests') {
      steps {
        container('gradle') {
          sh """
            ./gradlew integrationTest \
              -Dapp.base-url=https://\${APP_NAME}.\${DEV_NAMESPACE}.apps.\${CLUSTER_BASE_DOMAIN} \
              --no-daemon
          """
        }
      }
      post {
        always {
          junit '**/build/test-results/integrationTest/*.xml'
        }
      }
    }

    // ── 10. Promote to Production ─────────────────────────────────────────────
    stage('Promote to Production') {
      when {
        branch 'main'
      }
      input {
        message "Promote ${APP_NAME} ${IMAGE_TAG} to PRODUCTION?"
        parameters {
          string(
            name: 'JIRA_CHANGE_TICKET',
            description: 'Jira Change Request ticket (e.g. CHG-1234) — required by Kyverno policy',
            defaultValue: ''
          )
        }
      }
      steps {
        script {
          {% if values.requireJiraTicket %}
          if (!env.JIRA_CHANGE_TICKET?.trim()) {
            error "Production deployment requires a Jira change ticket (JIRA_CHANGE_TICKET is empty)"
          }
          {% endif %}
        }
        container('tools') {
          sshagent(credentials: ['bitbucket-gitops-ssh-key']) {
            sh """
              cd gitops-repo
              git pull origin main

              # Pin digest in prod overlay
              sed -i "s|image:.*${APP_NAME}:.*|image: \${IMAGE_WITH_DIGEST}|g" overlays/prod/kustomization.yaml

              # Inject required Jira change ticket annotation (enforced by Kyverno release-gate policy)
              yq e ".patches[0].patch = \"- op: add\\n  path: /spec/template/metadata/annotations/acme.io~1jira-change-ticket\\n  value: \${JIRA_CHANGE_TICKET}\"" \
                -i overlays/prod/deployment-patch.yaml 2>/dev/null || true

              git add .
              git commit -m "chore(prod): promote \${IMAGE_TAG} [\${JIRA_CHANGE_TICKET}]"
              git push origin main
            """
          }
        }
        container('tools') {
          sh """
            argocd app sync \${APP_NAME}-prod \
              --server openshift-gitops-server-openshift-gitops.apps.\${CLUSTER_BASE_DOMAIN} \
              --auth-token \${ARGOCD_TOKEN} \
              --grpc-web \
              --timeout 180

            argocd app wait \${APP_NAME}-prod \
              --server openshift-gitops-server-openshift-gitops.apps.\${CLUSTER_BASE_DOMAIN} \
              --auth-token \${ARGOCD_TOKEN} \
              --health --timeout 300
          """
        }
      }
    }
  }

  post {
    success {
      script {
        // Notify Jira ticket that deployment succeeded
        if (env.JIRA_CHANGE_TICKET) {
          jiraComment(
            site: 'acme-jira',
            issueKey: env.JIRA_CHANGE_TICKET,
            body: "✅ *${APP_NAME}* deployed to production successfully. Build: ${BUILD_URL} Image: ${IMAGE_WITH_DIGEST}"
          )
        }
      }
    }
    failure {
      script {
        if (env.JIRA_CHANGE_TICKET) {
          jiraComment(
            site: 'acme-jira',
            issueKey: env.JIRA_CHANGE_TICKET,
            body: "❌ *${APP_NAME}* deployment FAILED. Build: ${BUILD_URL}"
          )
        }
      }
    }
    always {
      archiveArtifacts artifacts: 'image.env', allowEmptyArchive: true
      cleanWs()
    }
  }
}
